# Kopiraj v .env in po potrebi spremeni (cp .env.example .env).

# --- Porti na gostitelju ---
API_PORT=8989
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL ---
# Za lokalni razvoj; postgres in redis sta dosegljiva samo s tega računalnika (127.0.0.1).
POSTGRES_USER=rift
POSTGRES_PASSWORD=rift-dev-geslo
POSTGRES_DB=rift_help

# --- Redis ---
REDIS_PASSWORD=rift-dev-geslo

# --- Backend (znotraj Docker omrežja; gesli se morata ujemati z zgornjima) ---
DATABASE_URL=postgresql+psycopg://rift:rift-dev-geslo@postgres:5432/rift_help
REDIS_URL=redis://:rift-dev-geslo@redis:6379/0

# --- Riot API ---
# Ključ z https://developer.riotgames.com (razvojni ključ velja 24 ur).
RIOT_API_KEY=
# fixtures = sintetični odgovori (deluje brez ključa), live = pravi Riot API (zahteva ključ in REDIS_URL)
RIOT_API_MODE=fixtures

# --- Frontend ---
# Naslov API, kot ga vidi brskalnik (vgradi se ob gradnji slike).
NEXT_PUBLIC_API_URL=http://localhost:8989
