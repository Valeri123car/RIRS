# Kopiraj v .env in po potrebi spremeni (cp .env.example .env).

# --- Porti na gostitelju ---
API_PORT=8989
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL ---
POSTGRES_USER=rift
POSTGRES_PASSWORD=rift
POSTGRES_DB=rift_help

# --- Backend (znotraj Docker omrežja) ---
DATABASE_URL=postgresql+psycopg://rift:rift@postgres:5432/rift_help
REDIS_URL=redis://redis:6379/0

# --- Riot API ---
# Ključ z https://developer.riotgames.com (razvojni ključ velja 24 ur).
RIOT_API_KEY=
# live = pravi Riot API, fixtures = posneti odgovori (deluje brez ključa)
RIOT_API_MODE=fixtures

# --- Frontend ---
# Naslov API, kot ga vidi brskalnik (vgradi se ob gradnji slike).
NEXT_PUBLIC_API_URL=http://localhost:8989
